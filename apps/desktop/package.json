    "smoke:merge": "node scripts/smoke-all.mjs merge",
    "smoke:git": "node scripts/smoke-all.mjs git",
    "smoke:actions": "node scripts/smoke-all.mjs actions",
    "smoke:extensions": "node scripts/smoke-all.mjs extensions",
    "smoke:tasks": "node scripts/smoke-all.mjs tasks",
    "prepare:sessiond": "node scripts/sessiond.mjs",
    "smoke:sessions": "node scripts/smoke-all.mjs sessions",
    "smoke:autosave": "node scripts/smoke-all.mjs autosave",
    "smoke:workspace": "node scripts/smoke-all.mjs workspace",
    "smoke:status": "node scripts/smoke-all.mjs status",
