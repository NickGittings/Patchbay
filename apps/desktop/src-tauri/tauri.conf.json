{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchbay",
  "version": "0.1.0",
  "identifier": "dev.patchbay.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sessiond && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sessiond.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchbay",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/patchbay-sessiond",
      "binaries/patchbay"
    ]
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
