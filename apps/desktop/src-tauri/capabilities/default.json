{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and component windows only; extension frames have opaque origins and receive no remote IPC capability",
  "windows": [
    "main",
    "component-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "opener:default"
  ],
  "webviews": [
    "main",
    "component-*"
  ]
}
